## GPH-GU 2182: loads the course helper commands when you open this project.
## It only runs in an interactive RStudio session.
## Deleting this file changes nothing about your work or your grade.
if (interactive()) {
  try({
    if (file.exists("gph2182.R")) {
      source("gph2182.R")
    } else {
      source("https://gph-2182.github.io/gph2182.R")
    }
    .gph_banner()
  }, silent = TRUE)
}
